# Copy this file to ".env" and fill in your actual local values.
# Never commit the real ".env" file to version control.

# development (default) or production. In production, QDRANT_URL becomes
# required — embedded/local Qdrant is a development-only fallback.
ENVIRONMENT=development

# Postgres connection — update <your_password> with what you set during install
DATABASE_URL=postgresql+psycopg2://postgres:<your_password>@localhost:5432/docflow_ai

# Groq API key (for later phases — LLM calls). Leave blank for now if not needed yet.
GROQ_API_KEY=

# Max upload size in bytes (10MB, per Phase 1 decision — temporary, blob-era limit)
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Phase 2: Authentication ---------------------------------------------------

# Secret for HMAC-signing session tokens + OAuth state. REQUIRED for auth.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_TOKEN_SECRET=

# Session token lifetime, seconds (default 28800 = 8h)
SESSION_TOKEN_TTL_SECONDS=28800

# PBKDF2-HMAC-SHA256 iteration count (default 310000)
PASSWORD_HASH_ITERATIONS=310000

# Google OAuth2 client credentials (Google Cloud Console > Credentials).
# Leave blank to disable Google sign-in (/auth/google/* then returns 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match an "Authorized redirect URI" on the OAuth client above.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the SPA runs — the Google callback 302-redirects here with ?auth_token=.
FRONTEND_URL=http://localhost:5173

# tenants.tenant_id (UUID) that new signups / first-time Google users are
# attached to. REQUIRED for signup + Google sign-up to work.
DEFAULT_SIGNUP_TENANT_ID=

# --- Phase A: RAG / vector store (Qdrant) -------------------------------------
# Leave QDRANT_URL BLANK to use embedded local mode (on-disk, no server, no key).
# Set it to connect to a real Qdrant:
#   local Docker:   QDRANT_URL=http://localhost:6333        (no API key needed)
#   Qdrant Cloud:   QDRANT_URL=https://xxxx.cloud.qdrant.io  + QDRANT_API_KEY=...
# REQUIRED (not optional) when ENVIRONMENT=production — app/config.py refuses
# to start otherwise, rather than silently falling back to embedded mode.
QDRANT_URL=
QDRANT_API_KEY=
# Directory for embedded local mode (only used when QDRANT_URL is blank).
QDRANT_LOCAL_PATH=qdrant_storage
